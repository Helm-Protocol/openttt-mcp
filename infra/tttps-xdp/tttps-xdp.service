[Unit]
Description=TTTPS L4 XDP ingress rate limiter
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/tttps-xdp.conf

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/tttps-xdp.conf
ExecStart=/usr/local/libexec/tttps-xdp-load ${TTTPS_XDP_IFACE} ${TTTPS_XDP_BASE}
ExecStop=/usr/local/libexec/tttps-xdp-unload ${TTTPS_XDP_IFACE}

[Install]
WantedBy=multi-user.target
